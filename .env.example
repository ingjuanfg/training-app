# Copia este archivo a .env.local y completa los valores

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Usa la service_role key (solo servidor). Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secreto para firmar cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
